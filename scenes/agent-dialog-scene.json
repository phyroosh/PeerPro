{
  "$schema": "../schemas/scene-definition.schema.json",
  "id": "agent-tokyo-encounter",
  "name": "Afternoon Street Encounter in Tokyo",
  "description": "Agent-composed multi-character narrative scene with camera pan, atmospheric sakura petals, and timed dialog subtitles.",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "durationInFrames": 120,
    "backgroundColor": "#090d16"
  },
  "camera": {
    "preset": "pan-left-to-right",
    "intensity": 0.85,
    "focalDepth": 1.0
  },
  "environment": {
    "preset": "japanese-street-corner"
  },
  "characters": [
    {
      "id": "hero-ren",
      "characterId": "student-ren",
      "variant": "default",
      "depth": 1.0,
      "position": {
        "x": 840,
        "y": 920
      },
      "scale": 0.95,
      "animation": {
        "breathing": {
          "frequency": 0.5,
          "amplitude": 3.5
        },
        "headTilt": {
          "frequency": 0.35,
          "maxAngle": 1.8
        },
        "expressionSchedule": [
          {
            "startFrame": 0,
            "eyes": "starter-char-eyes-neutral",
            "mouth": "starter-char-mouth-closed"
          },
          {
            "startFrame": 40,
            "eyes": "starter-char-eyes-wink",
            "mouth": "starter-char-mouth-smile"
          },
          {
            "startFrame": 85,
            "eyes": "starter-char-eyes-wide",
            "mouth": "starter-char-mouth-closed"
          }
        ]
      }
    },
    {
      "id": "friend-kai",
      "characterId": "student-ren",
      "variant": "casual",
      "depth": 1.05,
      "position": {
        "x": 1280,
        "y": 930
      },
      "scale": 0.92,
      "flipX": true,
      "animation": {
        "breathing": {
          "frequency": 0.55,
          "amplitude": 3.0
        },
        "headTilt": {
          "frequency": 0.4,
          "maxAngle": 2.0
        }
      }
    }
  ],
  "effects": [
    {
      "id": "sakura-petals",
      "type": "petals",
      "count": 28,
      "depth": 1.3,
      "opacity": 0.8
    }
  ],
  "dialog": [
    {
      "id": "line-1",
      "speaker": "Ren",
      "text": "Hey, meet me by the vending machine before sunset!",
      "startFrame": 15,
      "endFrame": 65
    },
    {
      "id": "line-2",
      "speaker": "Kai",
      "text": "Already here! Grabbed some iced tea while waiting.",
      "startFrame": 70,
      "endFrame": 115
    }
  ]
}
