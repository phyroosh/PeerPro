{
  "name": "peerpro",
  "version": "0.1.0",
  "private": true,
  "description": "PeerPro - AI-Agent 2.5D Animation Playground",
  "repository": {
    "type": "git",
    "url": "https://github.com/phyroosh/PeerPro.git"
  },
  "license": "MIT",
  "keywords": [
    "remotion",
    "animation",
    "ai-agent",
    "react",
    "parallax",
    "video",
    "character-builder",
    "frame-deterministic"
  ],
  "scripts": {
    "dev": "remotion studio",
    "build": "tsc --noEmit",
    "render:still": "remotion still PeerProSandbox out/smoke-test.png --frame=45",
    "render:video": "remotion render PeerProSandbox out/smoke-test.mp4",
    "render:showcase:still": "remotion still CharacterShowcase out/character-showcase.png --frame=30",
    "render:showcase:video": "remotion render CharacterShowcase out/character-showcase.mp4",
    "render:env:corner": "remotion still EnvironmentShowcase out/env-corner.png --frame=40",
    "render:env:quiet": "remotion still EnvironmentShowcase out/env-quiet.png --frame=120",
    "render:env:video": "remotion render EnvironmentShowcase out/environment-showcase.mp4",
    "render:parallax:start": "remotion still ParallaxTest out/parallax-start.png --frame=0",
    "render:parallax:mid": "remotion still ParallaxTest out/parallax-mid.png --frame=60",
    "render:parallax:end": "remotion still ParallaxTest out/parallax-end.png --frame=119",
    "render:parallax:video": "remotion render ParallaxTest out/parallax-test.mp4",
    "render:scene:still": "remotion still AgentScene out/scene-agent-test.png --frame=45",
    "render:scene:video": "remotion render AgentScene out/scene-agent-test.mp4",
    "render:style:still": "remotion still StyleShowcase out/style-showcase.png --frame=60",
    "render:style:video": "remotion render StyleShowcase out/style-showcase.mp4",
    "render:cutout:still": "remotion still CutoutRigShowcase out/cutout-showcase.png --frame=60",
    "render:cutout:video": "remotion render CutoutRigShowcase out/cutout-showcase.mp4",
    "render:classroom:still": "remotion still ClassroomShowcase out/classroom-showcase.png --frame=60",
    "render:classroom:video": "remotion render ClassroomShowcase out/classroom-showcase.mp4",
    "render:action:still": "remotion still ActionShowcase out/action-showcase.png --frame=52",
    "render:action:video": "remotion render ActionShowcase out/action-showcase.mp4",
    "render:cinematic:still": "remotion still CinematicSequenceShowcase out/cinematic-sequence.png --frame=105",
    "render:cinematic:video": "remotion render CinematicSequenceShowcase out/cinematic-sequence.mp4",
    "render:audio:still": "remotion still AudioNarrativeShowcase out/audio-narrative-showcase.png --frame=45",
    "render:audio:video": "remotion render AudioNarrativeShowcase out/audio-narrative-showcase.mp4",
    "agent:discover": "tsx scripts/agent-discover.ts",
    "scene:inspect": "tsx scripts/inspect-scene.ts",
    "scene:analyze": "tsx scripts/analyze-scene.ts",
    "scene:correct": "tsx scripts/correct-scene.ts",
    "scene:render": "tsx scripts/render-scene.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "verify:all": "tsx scripts/verify-all.ts",
    "assets:validate": "tsx scripts/validate-assets.ts",
    "assets:index": "tsx scripts/build-asset-index.ts",
    "assets:contact-sheet": "tsx scripts/build-contact-sheet.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.528",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.528",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
